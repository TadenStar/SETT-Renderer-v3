{
  "schema_version": 1,
  "name": "Heavy Scene",
  "order": 50,
  "description": "Balanced for simulations and huge scenes at risk of running out of memory: no Persistent Data, tile 512, texture limit 2048, denoising on the CPU, 20-frame chunks.",
  "engine": null,
  "output": {
    "file_format": "PNG",
    "color_mode": "RGBA",
    "color_depth": "16",
    "compression": 15,
    "resolution_percentage": 100
  },
  "common": {
    "render.use_persistent_data": false,
    "render.use_simplify": true,
    "render.simplify_subdivision_render": 3
  },
  "cycles": {
    "cycles.use_adaptive_sampling": true,
    "cycles.adaptive_threshold": 0.01,
    "cycles.samples": 1024,
    "cycles.adaptive_min_samples": 32,
    "cycles.time_limit": 0,
    "cycles.sampling_pattern": {"prefer": ["BLUE_NOISE", "TABULATED_SOBOL", "SOBOL_BURLEY", "AUTOMATIC"]},
    "cycles.use_animated_seed": false,
    "cycles.use_denoising": true,
    "cycles.denoiser": {"prefer": ["OPENIMAGEDENOISE", "OPTIX"]},
    "cycles.denoising_input_passes": "RGB_ALBEDO_NORMAL",
    "cycles.denoising_prefilter": "ACCURATE",
    "cycles.denoising_quality": "BALANCED",
    "cycles.denoising_use_gpu": false,
    "cycles.max_bounces": 8,
    "cycles.diffuse_bounces": 3,
    "cycles.glossy_bounces": 4,
    "cycles.transmission_bounces": 8,
    "cycles.volume_bounces": 1,
    "cycles.transparent_max_bounces": 8,
    "cycles.sample_clamp_direct": 0,
    "cycles.sample_clamp_indirect": 10,
    "cycles.blur_glossy": 1.0,
    "cycles.caustics_reflective": false,
    "cycles.caustics_refractive": false,
    "cycles.use_light_tree": true,
    "cycles.use_fast_gi": true,
    "cycles.fast_gi_method": "ADD",
    "cycles.ao_bounces_render": 2,
    "cycles.auto_scrambling_distance": true,
    "cycles.volume_step_rate": 2.0,
    "cycles.volume_max_steps": 512,
    "cycles.volume_preview_step_rate": 4.0,
    "cycles.texture_limit_render": "2048",
    "cycles.use_auto_tile": true,
    "cycles.tile_size": 512
  },
  "eevee": {
    "eevee.taa_render_samples": 64,
    "eevee.use_shadows": true,
    "eevee.shadow_ray_count": 2,
    "eevee.shadow_step_count": 4,
    "eevee.use_raytracing": true,
    "eevee.ray_tracing_options.resolution_scale": "2",
    "eevee.use_volumetric_shadows": true,
    "eevee.volumetric_tile_size": "4",
    "eevee.volumetric_samples": 64,
    "eevee.use_overscan": true,
    "eevee.overscan_size": 5.0
  },
  "view_layer": {},
  "chunk_size": 20
}
